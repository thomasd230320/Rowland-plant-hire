# Copy this file to .env.local and fill in the values.
# On Netlify these same names go in: Site settings -> Environment variables.

# --- Supabase (customer accounts + saved quotes) ----------------------------
# https://supabase.com/dashboard -> your project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Keystatic (the /keystatic editing panel) -------------------------------
# Leave these blank locally: with no client ID, Keystatic edits the files in
# /content directly on your machine, which is what you want for development.
#
# On Netlify all four must be set, or the panel cannot save to GitHub.
# They come from the GitHub App created by visiting /keystatic on the deployed
# site and following the setup prompts. See DEPLOYMENT.md.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Any long random string; it signs the editor's login cookie.
# Generate one with:  openssl rand -hex 32
KEYSTATIC_SECRET=
